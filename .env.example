# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# JWT Authentication Secret
JWT_SECRET="ganti_dengan_jwt_secret_yang_panjang_dan_aman_min_32_karakter"

# Default Superadmin Credentials
DEFAULT_SUPERADMIN_USERNAME="superadmin"
DEFAULT_SUPERADMIN_PASSWORD="SuperAdmin123!"

# Google Cloud Service Account & Workspace Integration
# Spreadsheet ID: 16yW3FqOX_0jJy6jOxkV0U0CuutwokKlsASx5o9SPqR4
SPREADSHEET_ID="16yW3FqOX_0jJy6jOxkV0U0CuutwokKlsASx5o9SPqR4"
# Drive Folder ID: 1NMHXWSGtZU5j-I9HBb9fabB-jU0w0HJk
DRIVE_FOLDER_ID="1NMHXWSGtZU5j-I9HBb9fabB-jU0w0HJk"
# Path ke file JSON kredensial Service Account (letakkan di root folder)
GOOGLE_APPLICATION_CREDENTIALS="service-account-key.json"
# Atau bisa diisi langsung JSON string (opsional jika ditaruh di secret env)
# GOOGLE_SERVICE_ACCOUNT_JSON=""

# WhatsApp Gateway (Fonnte)
# Daftar di https://fonnte.com dan ambil token device Anda
FONNTE_TOKEN=""
FONNTE_SUPERADMIN_PHONE="081234567890"

